version     = "0.1.0"
author      = "daveey"
description = "Tribunal: an adjudication coworld for the Softmax Coworld platform. Two advocates scored on winning the verdict, three jurors scored on matching a hidden truth; a policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
